{
  "schema": "a2-golden-case-file@1",
  "task_id": "T0-10",
  "title": "Security, path, privacy and network: Node.run logger, PII canary, telemetry, illegal Dataset paths",
  "annotator": "claude-sonnet-5.5 worker, hand annotation on 2026-10-24 (human-style reading; no program produced any expected value)",
  "independence_statement": "Each hostile path and each leak scenario was chosen by hand from common attack lists. Verdicts (accept or reject) are the plain security answer. No path validator, logger or A2 code was run or imported. The NUL character is written as a JSON escape.",
  "provenance": {
    "sources": [
      "docs/microsoft-graph-error-handling.md: non-propagating safe logger with bounded purpose/reason/count replacements",
      "docs/dependency-vulnerability-policy.md and msgloom-security-review.md (privacy and dependency stance)",
      "docs/notes/parser-isolation.md (isolated worker, no network)",
      "docs/notes/container-deployment.md (network and filesystem boundaries)",
      "docs/component-layout.md: logger names and safe logging",
      "AGENTS.md: portable tests; linux_cgroup_v2 label for OS security integration tests"
    ]
  },
  "canary": "CANARY-PII-7731-ZQ",
  "cases": [
    {
      "case_id": "T0-10-P01",
      "polarity": "positive",
      "title": "Relative Dataset path inside the project data root is accepted",
      "input": {"kind": "dataset_path", "root": "<tmp>/data", "path": "02_intermediate/prepared/part-0001.json"},
      "expected": {"accepted": true}
    },
    {
      "case_id": "T0-10-P02",
      "polarity": "positive",
      "title": "Node.run logs only identifiers and counts",
      "input": {"kind": "node_log", "node": "prepare_mail", "inputs": {"record_count": 3}, "record_text": "CANARY-PII-7731-ZQ"},
      "expected": {"log_may_contain": ["node name", "record_count", "status", "bounded reason code"], "log_contains_canary": false}
    },
    {
      "case_id": "T0-10-P03",
      "polarity": "positive",
      "title": "Telemetry is disabled by default",
      "input": {"kind": "telemetry_default"},
      "expected": {"telemetry_enabled": false, "outbound_telemetry_connections": 0}
    },
    {
      "case_id": "T0-10-P04",
      "polarity": "positive",
      "title": "Error text is bounded and has the canary replaced",
      "input": {"kind": "error_message", "raw": "parse failed near CANARY-PII-7731-ZQ at byte 91"},
      "expected": {"logged_contains_canary": false, "logged_contains_reason_code": true}
    },
    {
      "case_id": "T0-10-N01",
      "polarity": "negative",
      "title": "Dataset path with parent traversal is rejected",
      "input": {"kind": "dataset_path", "root": "<tmp>/data", "path": "../outside/secret.json"},
      "expected": {"accepted": false, "reason": "traversal"}
    },
    {
      "case_id": "T0-10-N02",
      "polarity": "negative",
      "title": "Traversal hidden in the middle of a path is rejected",
      "input": {"kind": "dataset_path", "root": "<tmp>/data", "path": "02_intermediate/../../outside.json"},
      "expected": {"accepted": false, "reason": "traversal"}
    },
    {
      "case_id": "T0-10-N03",
      "polarity": "negative",
      "title": "Absolute POSIX path is rejected",
      "input": {"kind": "dataset_path", "root": "<tmp>/data", "path": "/etc/passwd"},
      "expected": {"accepted": false, "reason": "absolute"}
    },
    {
      "case_id": "T0-10-N04",
      "polarity": "negative",
      "title": "Windows drive absolute path is rejected on every host",
      "input": {"kind": "dataset_path", "root": "<tmp>/data", "path": "C:\\Users\\example\\secret.json"},
      "expected": {"accepted": false, "reason": "absolute"}
    },
    {
      "case_id": "T0-10-N05",
      "polarity": "negative",
      "title": "UNC path is rejected",
      "input": {"kind": "dataset_path", "root": "<tmp>/data", "path": "\\\\files.example.invalid\\share\\out.json"},
      "expected": {"accepted": false, "reason": "unc"}
    },
    {
      "case_id": "T0-10-N06",
      "polarity": "negative",
      "title": "Forward-slash UNC form is rejected",
      "input": {"kind": "dataset_path", "root": "<tmp>/data", "path": "//files.example.invalid/share/out.json"},
      "expected": {"accepted": false, "reason": "unc_or_absolute"}
    },
    {
      "case_id": "T0-10-N07",
      "polarity": "negative",
      "title": "Path containing a NUL character is rejected",
      "input": {"kind": "dataset_path", "root": "<tmp>/data", "path": "02_intermediate/ok.json\u0000.txt"},
      "expected": {"accepted": false, "reason": "nul"}
    },
    {
      "case_id": "T0-10-N08",
      "polarity": "negative",
      "title": "Symlink inside the root that points outside is rejected",
      "input": {
        "kind": "dataset_path",
        "root": "<tmp>/data",
        "setup": "create symlink <tmp>/data/link -> <tmp>/outside, then open path link/secret.json",
        "path": "link/secret.json"
      },
      "expected": {"accepted": false, "reason": "symlink_escape"}
    },
    {
      "case_id": "T0-10-N09",
      "polarity": "negative",
      "title": "Empty path is rejected",
      "input": {"kind": "dataset_path", "root": "<tmp>/data", "path": ""},
      "expected": {"accepted": false, "reason": "empty"}
    },
    {
      "case_id": "T0-10-N10",
      "polarity": "negative",
      "title": "Backslash traversal is rejected on every host",
      "input": {"kind": "dataset_path", "root": "<tmp>/data", "path": "..\\outside.json"},
      "expected": {"accepted": false, "reason": "traversal"}
    },
    {
      "case_id": "T0-10-N11",
      "polarity": "negative",
      "title": "Node.run logger must not print record text",
      "input": {"kind": "node_log", "node": "prepare_mail", "record_text": "CANARY-PII-7731-ZQ"},
      "expected": {"log_contains_canary": false, "propagates_to_root_logger_with_payload": false}
    },
    {
      "case_id": "T0-10-N12",
      "polarity": "negative",
      "title": "Exception traceback must not carry the canary into logs or stored status",
      "input": {"kind": "exception", "message": "bad value CANARY-PII-7731-ZQ"},
      "expected": {"log_contains_canary": false, "stored_status_contains_canary": false}
    },
    {
      "case_id": "T0-10-N13",
      "polarity": "negative",
      "title": "Kedro usage telemetry or any outbound call during a run is a failure",
      "input": {"kind": "network_probe", "run": "offline synthetic pipeline run"},
      "expected": {"outbound_connections": 0, "dns_lookups_to_non_loopback": 0, "telemetry_consent_prompt": false}
    },
    {
      "case_id": "T0-10-P05",
      "polarity": "positive",
      "title": "Percent-encoded dots are a literal directory name and are never decoded",
      "input": {"kind": "dataset_path", "root": "<tmp>/data", "path": "02_intermediate/%2e%2e/inside.json"},
      "expected": {"accepted": true, "decoded_before_check": false, "resolved_inside_root": true}
    }
  ]
}
